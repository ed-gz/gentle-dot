--- /dev/null
+++ b/src/platform/companion_layout.rs
@@ -0,0 +1,82 @@
+//! Opt-in, geometry-only TUI presentation. This is not a server/wire protocol.
+use serde::Serialize;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct Layout {
+    pub columns: u16,
+    pub rows: u16,
+    pub revision: u64,
+    pub server_boot_id: Option<String>,
+    pub overlay_active: bool,
+    pub outer_focused: Option<bool>,
+    pub available: bool,
+    pub focused_pane_id: Option<String>,
+    pub panes: Vec<Pane>,
+    pub sidebar_rows: Vec<SidebarRow>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct Rect {
+    pub x: u16,
+    pub y: u16,
+    pub width: u16,
+    pub height: u16,
+}
+impl From<ratatui::layout::Rect> for Rect {
+    fn from(r: ratatui::layout::Rect) -> Self {
+        Self {
+            x: r.x,
+            y: r.y,
+            width: r.width,
+            height: r.height,
+        }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct Pane {
+    pub pane_id: String,
+    pub inner_rect: Rect,
+    pub scroll_offset: Option<usize>,
+    pub endpoint: &'static str,
+}
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct SidebarRow {
+    pub pane_id: String,
+    pub rect: Rect,
+    pub endpoint: &'static str,
+}
+
+/// Acquisition as well as I/O is capped at once per second, independent of pane output rate.
+#[derive(Default)]
+pub(crate) struct Throttle {
+    last: Option<std::time::Instant>,
+}
+impl Throttle {
+    pub fn due(&mut self, now: std::time::Instant) -> bool {
+        if self.last.is_some_and(|last| {
+            now.saturating_duration_since(last) < std::time::Duration::from_secs(1)
+        }) {
+            return false;
+        }
+        self.last = Some(now);
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn companion_layout_throttle_does_not_accumulate_per_render_work() {
+        let mut throttle = Throttle::default();
+        let now = std::time::Instant::now();
+        assert!(throttle.due(now));
+        for millis in 0..1000 {
+            assert!(!throttle.due(now + std::time::Duration::from_millis(millis)));
+        }
+        assert!(throttle.due(now + std::time::Duration::from_secs(1)));
+        assert!(!throttle.due(now + std::time::Duration::from_secs(1)));
+    }
+}
