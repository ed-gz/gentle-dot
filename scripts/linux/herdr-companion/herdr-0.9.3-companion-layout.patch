index 0000000..ccf2f95
--- /dev/null
+++ b/src/client/shell/companion_layout.rs
@@ -0,0 +1,211 @@
+//! Geometry is copied from the last presented client hit map, never reconstructed from text.
+use super::*;
+use crate::platform::companion_layout::{Layout, Pane, SidebarRow};
+
+impl ClientShellState {
+    pub(crate) fn companion_overlay_active(&self) -> bool {
+        self.overlay.is_some()
+            || self.mode != ClientShellMode::Terminal
+            || self.popup_pending
+            || self.hits.popup.is_some()
+            || !self.hits.notification_toast.is_empty()
+    }
+
+    pub(crate) fn companion_layout(
+        &self,
+        columns: u16,
+        rows: u16,
+        presented_at: Option<std::time::Instant>,
+        presentation_blocked: bool,
+    ) -> Layout {
+        let mut out = Layout {
+            columns,
+            rows,
+            outer_focused: self.outer_focused,
+            overlay_active: presentation_blocked || self.companion_overlay_active(),
+            ..Layout::default()
+        };
+        let (Some(snapshot), Some(surface)) =
+            (self.snapshot.as_deref(), self.pane_surface.as_ref())
+        else {
+            return out;
+        };
+        out.server_boot_id = Some(snapshot.boot_id.clone());
+        out.revision = snapshot.revision;
+        let coherent = self.active_endpoint_id.is_local()
+            && self.endpoint_status(&self.active_endpoint_id) == Some(ClientEndpointStatus::Online)
+            && self.endpoint_error.is_none()
+            && self.pending_pane_surface.is_none()
+            && self.pane_surface_generation == self.active_snapshot_generation
+            && snapshot.boot_id == surface.boot_id
+            && snapshot.revision == surface.projection_revision
+            && self.last_composed_size == Some((columns, rows))
+            && self
+                .last_composed_at
+                .zip(presented_at)
+                .is_some_and(|(composed, presented)| composed <= presented);
+        if !coherent || out.overlay_active {
+            return out;
+        }
+        out.available = true;
+        out.focused_pane_id = snapshot.focused_pane_id.clone();
+        out.panes = self
+            .hits
+            .panes
+            .iter()
+            .take(128)
+            .filter(|p| {
+                !p.inner_rect.is_empty()
+                    && p.inner_rect.right() <= columns
+                    && p.inner_rect.bottom() <= rows
+            })
+            .map(|p| Pane {
+                pane_id: p.pane_id.clone(),
+                inner_rect: p.inner_rect.into(),
+                scroll_offset: p.scroll.map(|s| s.offset_from_bottom),
+                endpoint: "local",
+            })
+            .collect();
+        out.sidebar_rows = self
+            .hits
+            .agents
+            .iter()
+            .map(|(rect, id)| (rect, id))
+            .chain(
+                self.hits
+                    .endpoint_agents
+                    .iter()
+                    .filter(|(_, endpoint, _)| endpoint.is_local())
+                    .map(|(rect, _, id)| (rect, id)),
+            )
+            .take(128)
+            .filter(|(r, _)| !r.is_empty() && r.right() <= columns && r.bottom() <= rows)
+            .map(|(rect, id)| SidebarRow {
+                pane_id: id.clone(),
+                rect: (*rect).into(),
+                endpoint: "local",
+            })
+            .collect();
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::tests::{snapshot, surface};
+    use super::*;
+    fn ready() -> ClientShellState {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        let mut data = snapshot();
+        data.agents.push(crate::protocol::ClientShellAgent {
+            pane_id: "pane_1".into(),
+            workspace_id: "ws_1".into(),
+            tab_id: "tab_1".into(),
+            name: Some("private-agent-title".into()),
+            display_agent: None,
+            agent: Some("pi".into()),
+            title: None,
+            terminal_title: None,
+            terminal_title_stripped: None,
+            agent_status: crate::api::schema::AgentStatus::Idle,
+            state_change_seq: 1,
+            state_labels: vec![],
+            tokens: vec![],
+            focused: true,
+        });
+        state.set_snapshot(Box::new(data));
+        state.set_pane_surface(surface());
+        state.compose(100, 30).expect("fixture frame");
+        state
+    }
+    #[test]
+    fn companion_layout_uses_actual_presented_pane_and_sidebar_coordinates_without_text() {
+        let mut state = ready();
+        state.hits.panes[0].scroll = Some(crate::pane::ScrollMetrics {
+            offset_from_bottom: 0,
+            max_offset_from_bottom: 10,
+            viewport_rows: 2,
+        });
+        let layout = state.companion_layout(100, 30, Some(std::time::Instant::now()), false);
+        assert!(layout.available);
+        assert_eq!(
+            layout.panes[0].inner_rect,
+            state.hits.panes[0].inner_rect.into()
+        );
+        assert_eq!(layout.panes[0].scroll_offset, Some(0));
+        assert_eq!(layout.sidebar_rows[0].pane_id, "pane_1");
+        assert_eq!(layout.sidebar_rows[0].rect, state.hits.agents[0].0.into());
+        assert!(layout.panes[0].inner_rect.x > layout.sidebar_rows[0].rect.x);
+        let text = serde_json::to_string(&layout).unwrap();
+        assert!(
+            !text.contains("LIVE")
+                && !text.contains("/repo")
+                && !text.contains("private-agent-title")
+        );
+    }
+    #[test]
+    fn companion_layout_rejects_unpresented_resized_frozen_overlay_and_disconnected_views() {
+        let mut state = ready();
+        let now = Some(std::time::Instant::now());
+        assert!(!state.companion_layout(100, 30, None, false).available);
+        assert!(!state.companion_layout(101, 30, now, false).available);
+        assert!(!state.companion_layout(100, 30, now, true).available);
+        state.overlay = Some(ClientShellOverlay::Onboarding);
+        let hidden = state.companion_layout(100, 30, now, false);
+        assert!(!hidden.available && hidden.overlay_active && hidden.panes.is_empty());
+        state.overlay = None;
+        state.hits.panes[0].scroll = None;
+        assert_eq!(
+            state.companion_layout(100, 30, now, false).panes[0].scroll_offset,
+            None
+        );
+        state.compose(100, 30).expect("next frame");
+        assert!(!state.companion_layout(100, 30, now, false).available);
+        state.invalidate_pane_surface();
+        assert!(!state.companion_layout(100, 30, now, false).available);
+    }
+    #[test]
+    fn companion_layout_withholds_fast_patch_geometry_until_repaint_succeeds() {
+        let mut client = crate::client::state::ClientState::test_new();
+        client.shell = Some(ready());
+        client.reported_size = (100, 30);
+        client.companion_presented_at = Some(std::time::Instant::now());
+        assert!(client.companion_layout_snapshot().available);
+
+        // The retained patch path updates its hit map before writing stdout. On a
+        // write/flush error it requests a repaint without advancing composed_at.
+        client.shell.as_mut().unwrap().hits.panes[0].scroll = Some(crate::pane::ScrollMetrics {
+            offset_from_bottom: 0,
+            max_offset_from_bottom: 10,
+            viewport_rows: 2,
+        });
+        client.request_repaint();
+        let rejected = client.companion_layout_snapshot();
+        assert!(!rejected.available && rejected.panes.is_empty());
+
+        // Only a successfully presented replacement clears this upstream flag.
+        client.repaint_pending = false;
+        client.companion_presented_at = Some(std::time::Instant::now());
+        let restored = client.companion_layout_snapshot();
+        assert!(restored.available);
+        assert_eq!(restored.panes[0].scroll_offset, Some(0));
+    }
+    #[test]
+    #[ignore = "local geometry-only scaling profile, no terminals"]
+    fn companion_layout_profile_one_and_fifteen_panes() {
+        for count in [1, 15] {
+            let mut state = ready();
+            let pane = state.hits.panes[0].clone();
+            state.hits.panes = vec![pane; count];
+            let presented = Some(std::time::Instant::now());
+            let start = std::time::Instant::now();
+            for _ in 0..20000 {
+                std::hint::black_box(state.companion_layout(100, 30, presented, false));
+            }
+            eprintln!(
+                "companion_layout panes={count} samples=20000 elapsed_us={}",
+                start.elapsed().as_micros()
+            );
+        }
+    }
+}
