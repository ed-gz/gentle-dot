index 0000000..cb7598c
--- /dev/null
+++ b/src/platform/linux/companion_layout.rs
@@ -0,0 +1,339 @@
+//! Linux-only opt-in publisher. No I/O occurs in rendering or pane loops.
+use crate::platform::companion_layout::{Layout, Throttle};
+use serde::Serialize;
+use std::{
+    fs::{File, OpenOptions},
+    io::{self, Read, Write},
+    os::{
+        fd::AsRawFd,
+        unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt},
+    },
+    path::{Path, PathBuf},
+    sync::mpsc::{self, SyncSender},
+    time::Instant,
+};
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Identity {
+    version: u8,
+    client_pid: u32,
+    process_identity: String,
+    tty: String,
+    kitty_window_id: u64,
+    herdr_socket_path: String,
+}
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Report<'a> {
+    #[serde(flatten)]
+    identity: &'a Identity,
+    observed_at: &'a str,
+    #[serde(flatten)]
+    layout: &'a Layout,
+}
+pub(crate) struct CompanionLayoutPublisher {
+    sender: SyncSender<(Layout, String)>,
+    throttle: Throttle,
+}
+impl CompanionLayoutPublisher {
+    pub(crate) fn from_environment() -> Option<Self> {
+        let directory = std::env::var_os("GENTLE_DOT_COMPANION_LAYOUT_DIR")?;
+        match Self::start(Path::new(&directory)) {
+            Ok(publisher) => Some(publisher),
+            Err(error) => {
+                tracing::warn!(%error,"optional companion geometry unavailable");
+                None
+            }
+        }
+    }
+    fn start(directory: &Path) -> io::Result<Self> {
+        let directory = private_directory(directory)?;
+        let identity = identity()?;
+        cleanup_dead_reports(&directory);
+        let (sender, receiver) = mpsc::sync_channel::<(Layout, String)>(1);
+        std::thread::Builder::new()
+            .name("companion-layout".into())
+            .spawn(move || {
+                let anchor = PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd()));
+                let name = format!("{}.json", identity.client_pid);
+                let mut sequence = 0_u64;
+                for (layout, observed_at) in receiver {
+                    sequence = sequence.wrapping_add(1);
+                    let report = Report {
+                        identity: &identity,
+                        observed_at: &observed_at,
+                        layout: &layout,
+                    };
+                    let result = serde_json::to_vec(&report)
+                        .map_err(io::Error::other)
+                        .and_then(|bytes| atomic_write(&anchor, &name, sequence, &bytes));
+                    if let Err(error) = result {
+                        tracing::debug!(%error,"optional companion layout publication skipped");
+                    }
+                }
+                let _ = std::fs::remove_file(anchor.join(name));
+            })?;
+        Ok(Self {
+            sender,
+            throttle: Throttle::default(),
+        })
+    }
+    pub(crate) fn due(&mut self, now: Instant) -> bool {
+        self.throttle.due(now)
+    }
+    pub(crate) fn publish(&self, layout: Layout) {
+        let Ok(now) =
+            time::OffsetDateTime::now_utc().format(&time::format_description::well_known::Rfc3339)
+        else {
+            return;
+        };
+        // Bounded and nonblocking. A stalled writer drops updates; stale consumers fail closed.
+        let _ = self.sender.try_send((layout, now));
+    }
+}
+fn private_directory(path: &Path) -> io::Result<File> {
+    if !path.is_absolute() {
+        return Err(io::Error::other(
+            "companion layout directory must be absolute",
+        ));
+    }
+    match std::fs::DirBuilder::new().mode(0o700).create(path) {
+        Ok(()) => {}
+        Err(e) if e.kind() == io::ErrorKind::AlreadyExists => {}
+        Err(e) => return Err(e),
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    let meta = file.metadata()?;
+    // SAFETY: geteuid has no arguments or memory effects.
+    if meta.uid() != unsafe { libc::geteuid() } || meta.mode() & 0o777 != 0o700 {
+        return Err(io::Error::other(
+            "companion layout directory must be owned by this user and mode 0700",
+        ));
+    }
+    Ok(file)
+}
+/// Abrupt terminal exit can leave a report behind. Cleanup is startup-only and
+/// never removes a live process, an unrecognized file, or a changed inode.
+fn cleanup_dead_reports(directory: &File) {
+    let anchor = PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd()));
+    let Ok(entries) = std::fs::read_dir(&anchor) else {
+        return;
+    };
+    let Ok(owner) = directory.metadata() else {
+        return;
+    };
+    for entry in entries.take(4096).flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        let Some(pid) = name
+            .strip_suffix(".json")
+            .and_then(|s| s.parse::<u32>().ok())
+        else {
+            continue;
+        };
+        if pid == 0 || name != format!("{pid}.json") {
+            continue;
+        }
+        let process = PathBuf::from(format!("/proc/{pid}"));
+        if !matches!(process.try_exists(), Ok(false)) {
+            continue;
+        }
+        let path = anchor.join(name);
+        let Ok(file) = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK | libc::O_CLOEXEC)
+            .open(&path)
+        else {
+            continue;
+        };
+        let Ok(metadata) = file.metadata() else {
+            continue;
+        };
+        if !metadata.is_file()
+            || metadata.uid() != owner.uid()
+            || metadata.mode() & 0o777 != 0o600
+            || metadata.len() > 65536
+        {
+            continue;
+        }
+        let mut bytes = Vec::new();
+        if file.take(65537).read_to_end(&mut bytes).is_err() || bytes.len() > 65536 {
+            continue;
+        }
+        let Ok(report) = serde_json::from_slice::<serde_json::Value>(&bytes) else {
+            continue;
+        };
+        let recognized = report.get("version").and_then(|v| v.as_u64()) == Some(1)
+            && report.get("clientPid").and_then(|v| v.as_u64()) == Some(u64::from(pid))
+            && report
+                .get("processIdentity")
+                .and_then(|v| v.as_str())
+                .is_some_and(|v| {
+                    v.split_once(':').is_some_and(|(boot, start)| {
+                        boot.len() == 36
+                            && !start.is_empty()
+                            && start.bytes().all(|c| c.is_ascii_digit())
+                    })
+                })
+            && report
+                .get("herdrSocketPath")
+                .and_then(|v| v.as_str())
+                .is_some_and(|v| v.starts_with('/'))
+            && report
+                .get("observedAt")
+                .and_then(|v| v.as_str())
+                .is_some_and(|v| {
+                    v.len() >= 20
+                        && v.len() <= 36
+                        && v.as_bytes().get(10) == Some(&b'T')
+                        && v.ends_with('Z')
+                });
+        if !recognized {
+            continue;
+        }
+        let unchanged = std::fs::symlink_metadata(&path).is_ok_and(|current| {
+            current.is_file() && current.dev() == metadata.dev() && current.ino() == metadata.ino()
+        });
+        if unchanged && matches!(process.try_exists(), Ok(false)) {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+}
+fn identity() -> io::Result<Identity> {
+    // SAFETY: isatty only queries the inherited stdin descriptor.
+    if unsafe { libc::isatty(0) } != 1 {
+        return Err(io::Error::other("companion layout requires a real TTY"));
+    }
+    let tty = std::fs::read_link("/proc/self/fd/0")?
+        .to_string_lossy()
+        .into_owned();
+    if !tty.starts_with("/dev/") {
+        return Err(io::Error::other("unknown client TTY"));
+    }
+    let pid = std::process::id();
+    let stat = std::fs::read_to_string("/proc/self/stat")?;
+    let start = stat
+        .rsplit_once(") ")
+        .and_then(|(_, rest)| rest.split_whitespace().nth(19))
+        .ok_or_else(|| io::Error::other("missing client start time"))?;
+    if !start.bytes().all(|c| c.is_ascii_digit()) {
+        return Err(io::Error::other("invalid client start time"));
+    }
+    let boot = std::fs::read_to_string("/proc/sys/kernel/random/boot_id")?;
+    let kitty = std::env::var("KITTY_WINDOW_ID")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|id| *id > 0 && *id <= 9_007_199_254_740_991)
+        .ok_or_else(|| io::Error::other("companion layout requires Kitty identity"))?;
+    let socket = crate::api::socket_path().canonicalize()?;
+    let client = crate::server::socket_paths::client_socket_path().canonicalize()?;
+    if client
+        != crate::server::socket_paths::derive_client_socket_from_api_socket(&socket)
+            .canonicalize()?
+    {
+        return Err(io::Error::other("client/API socket identity mismatch"));
+    }
+    Ok(Identity {
+        version: 1,
+        client_pid: pid,
+        process_identity: format!("{}:{start}", boot.trim()),
+        tty,
+        kitty_window_id: kitty,
+        herdr_socket_path: socket.to_string_lossy().into_owned(),
+    })
+}
+fn atomic_write(directory: &Path, name: &str, sequence: u64, bytes: &[u8]) -> io::Result<()> {
+    let temporary = directory.join(format!(".{name}-{sequence}.tmp"));
+    let result = (|| {
+        let mut output = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(&temporary)?;
+        output.write_all(bytes)?;
+        output.flush()?;
+        std::fs::rename(&temporary, directory.join(name))
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temporary);
+    }
+    result
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::{symlink, PermissionsExt};
+    #[test]
+    fn companion_layout_cleanup_removes_only_private_recognized_dead_reports() {
+        let base =
+            std::env::temp_dir().join(format!("herdr-companion-cleanup-{}", std::process::id()));
+        let directory = private_directory(&base).unwrap();
+        let dead = 1_000_000_000_u32;
+        assert!(!Path::new(&format!("/proc/{dead}")).exists());
+        let report = |pid: u32| {
+            serde_json::json!({"version":1,"clientPid":pid,
+            "processIdentity":"00000000-0000-0000-0000-000000000000:1",
+            "herdrSocketPath":"/fixture/qa.sock","observedAt":"2020-01-01T00:00:00Z"})
+        };
+        let put = |pid: u32, value: serde_json::Value| {
+            let path = base.join(format!("{pid}.json"));
+            std::fs::write(&path, serde_json::to_vec(&value).unwrap()).unwrap();
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+            path
+        };
+        let dead_path = put(dead, report(dead));
+        let alive = put(std::process::id(), report(std::process::id()));
+        let unknown = put(
+            dead + 1,
+            serde_json::json!({"version":1,"clientPid":dead+1}),
+        );
+        let shared = put(dead + 2, report(dead + 2));
+        std::fs::set_permissions(&shared, std::fs::Permissions::from_mode(0o644)).unwrap();
+        let target = put(dead + 3, report(dead + 4));
+        let link = base.join(format!("{}.json", dead + 4));
+        symlink(&target, &link).unwrap();
+        cleanup_dead_reports(&directory);
+        assert!(!dead_path.exists());
+        for path in [&alive, &unknown, &shared, &target, &link] {
+            assert!(path.exists());
+        }
+        std::fs::remove_dir_all(base).unwrap();
+    }
+    #[test]
+    fn companion_layout_output_is_private_atomic_and_rejects_symlinks_or_shared_dirs() {
+        let base = std::env::temp_dir().join(format!(
+            "herdr-companion-layout-{}-{}",
+            std::process::id(),
+            time::OffsetDateTime::now_utc().unix_timestamp_nanos()
+        ));
+        std::fs::create_dir(&base).unwrap();
+        let target = base.join("private");
+        let dir = private_directory(&target).unwrap();
+        let anchor = PathBuf::from(format!("/proc/self/fd/{}", dir.as_raw_fd()));
+        atomic_write(&anchor, "123.json", 1, b"{\"revision\":1}").unwrap();
+        atomic_write(&anchor, "123.json", 2, b"{\"revision\":2}").unwrap();
+        assert_eq!(
+            std::fs::read(target.join("123.json")).unwrap(),
+            b"{\"revision\":2}"
+        );
+        assert_eq!(
+            std::fs::metadata(target.join("123.json")).unwrap().mode() & 0o777,
+            0o600
+        );
+        assert_eq!(std::fs::read_dir(&target).unwrap().count(), 1);
+        let link = base.join("link");
+        symlink(&target, &link).unwrap();
+        assert!(private_directory(&link).is_err());
+        std::fs::set_permissions(&target, std::fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(private_directory(&target).is_err());
+        assert!(private_directory(Path::new("relative")).is_err());
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
