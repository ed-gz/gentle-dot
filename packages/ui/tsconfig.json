{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"outDir": "dist/types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"vite/client",
			"node"
		]
	},
	"references": [
		{
			"path": "../protocol"
		},
		{
			"path": "../theme-capri"
		}
	],
	"include": [
		"src",
		"src/**/*.json",
		"test",
		"vite.config.ts"
	]
}
