+/** In-process capability. Never serialize the opaque binding or callbacks to a transcript. */
+export interface LiveReviewConsent {
+	readonly toolCallId: string;
+	readonly sessionId: string;
+	readonly consentBinding: string;
+	readonly expiresAt: number;
+	readonly consent: ReviewConsentV3;
+	respond(input: { consentBinding: string; answer: "granted" | "declined" }): Promise<boolean>;
+	/** Withdraws remote access only. The original local dialog remains available. */
+	detach(): void;
+}
+export interface ReviewConsentBridgeAuthority {
+	toolCallId: string;
+	sessionId: string;
+	consentBinding: string;
+	expiresAt: number;
+	isPending(): boolean;
+	answer(answer: "granted" | "declined"): Promise<boolean>;
+}
+type ReviewConsentReceiver = (request: LiveReviewConsent) => (() => void) | undefined;
+const BRIDGE = Symbol.for("gentle-pi.review-consent.bridge/v1");
+
+/** The shared UI object crosses Pi's separate extension module roots. No event-bus authority. */
+export function connectReviewConsentBridge(ui: object, receive: ReviewConsentReceiver): () => void {
+	if (Reflect.get(ui, BRIDGE)) throw new Error("Review consent bridge already owned");
+	Object.defineProperty(ui, BRIDGE, { value: receive, configurable: true });
+	return () => { if (Reflect.get(ui, BRIDGE) === receive) Reflect.deleteProperty(ui, BRIDGE); };
+}
