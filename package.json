{
	"name": "gentle-dot",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "pnpm --filter @gentle-dot/ui build && node packages/daemon/src/cli.ts",
		"build": "pnpm --filter @gentle-dot/ui build",
		"package:runtime": "node scripts/package/stage-runtime.mjs",
		"start": "node packages/daemon/src/cli.ts",
		"test": "vitest run",
		"e2e": "playwright test",
		"e2e:mobile": "playwright test -c playwright.mobile.config.ts",
		"typecheck": "tsc -b && pnpm --filter @gentle-dot/mobile typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test:real": "GENTLE_DOT_REAL_AGENT=1 vitest run packages/daemon/test/real-agent.test.ts",
		"package:mac": "node scripts/package/package-mac.mjs",
		"package:linux": "node scripts/package/package-linux.mjs",
		"package:linux:check": "node scripts/package/linux-check.mjs",
		"mobile:connect": "node scripts/mobile/connect.mjs",
		"android:apk": "node scripts/mobile/build-android.mjs",
		"sessions:launch": "node scripts/orchestration/session.mjs",
		"security:check": "node scripts/security/check-repository.mjs",
		"security:history": "node scripts/security/check-repository.mjs --history",
		"security:secrets": "sh scripts/security/check-secrets.sh",
		"security:test": "node --test scripts/security/*.test.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
