{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capri",
  "version": "0.1.0",
  "identifier": "dev.gentledot.capri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Capri", "width": 390, "height": 844 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost wss:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../../desktop/src-tauri/icons/icon.png"],
    "iOS": { "minimumSystemVersion": "15.0" }
  }
}
